# Copy this file to ".env" and fill in values. ".env" is git-ignored - never commit keys.

# LLM supervisor backend: "ollama" (default: local model, no key needed) or "claude".
# FLUTTER_AI_LLM_BACKEND=ollama
# FLUTTER_AI_OLLAMA_URL=http://127.0.0.1:11434

# Needed only for the Claude backend.
ANTHROPIC_API_KEY=

# Optional overrides
# FLUTTER_AI_LLM_MODEL=llama3.1:8b        # or claude-opus-5 with the claude backend
# FLUTTER_AI_LLM_TIMEOUT=30
